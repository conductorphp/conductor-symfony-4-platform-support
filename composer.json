{
  "name": "conductor/symfony-4-platform-support",
  "version": "6.0.0",
  "description": "Conductor Symfony 4 Platform Support",
  "type": "library",
  "homepage": "https://github.com/conductorphp/conductor-symfony-4-platform-support",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Kirk Madera",
      "email": "kirk.madera@rmgmedia.com",
      "role": "Architect"
    }
  ],
  "config": {
    "sort-packages": true
  },
  "require": {
    "php": "~8.4.1|~8.5.0",
    "conductor/application-orchestration": "^5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0",
    "laminas/laminas-coding-standard": "~1.0.0"
  },
  "autoload": {
    "psr-4": {
      "ConductorSymfony4PlatformSupport\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ConductorSymfony4PlatformSupportTest\\": "test/"
    }
  },
  "extra": {
    "laminas": {
      "config-provider": "ConductorSymfony4PlatformSupport\\ConfigProvider"
    }
  },
  "scripts": {
    "check": [
      "@cs-check",
      "@test"
    ],
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "test": "phpunit --colors=always",
    "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
  }
}